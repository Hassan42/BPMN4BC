    "sirv-cli": "^1.0.11",
    "webpack": "^5.28.0",
    "webpack-cli": "^4.5.0"
  },
  "dependencies": {
    "axios": "^1.8.1",
    "bpmn-js": "^17.6.4",
    "bpmn-js-properties-panel": "^5.16.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
