      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Participant_Recipient_di" bpmnElement="Participant_Recipient" isHorizontal="true">
        <dc:Bounds x="100" y="590" width="1100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Assoc_SubmitWrite_di" bpmnElement="Assoc_SubmitWrite">
        <di:waypoint x="290" y="440" />
