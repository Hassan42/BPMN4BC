      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Msg_Pay_di" bpmnElement="Flow_Msg_Pay">
        <di:waypoint x="860" y="440" />
        <di:waypoint x="860" y="590" />
      </bpmndi:BPMNEdge>
