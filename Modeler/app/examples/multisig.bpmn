          <dc:Bounds x="983" y="345" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_WalletEnd_di" bpmnElement="Event_WalletEnd">
        <dc:Bounds x="1112" y="382" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Wallet_3_di" bpmnElement="DS_Wallet_3">
        <dc:Bounds x="885" y="485" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="895" y="542" width="31" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_Wallet_1_di" bpmnElement="DS_Wallet_1">
        <dc:Bounds x="265" y="485" width="50" height="50" />
