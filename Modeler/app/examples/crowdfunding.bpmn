<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bpmnbc="http://some-company/schema/bpmn/qa" id="crowdfunding" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn2:collaboration id="Collaboration_43247181">
    <bpmn2:participant id="Participant_Creator" name="Creator" processRef="Process_Creator" />
    <bpmn2:participant id="Participant_Campaign" bpmnbc:bc="true" bpmnbc:bctype="Participant" bpmnbc:bcid="network-1" name="Crowdfunding Campaign" processRef="Process_Campaign" />
    <bpmn2:messageFlow id="Flow_Msg_Launch" sourceRef="Task_SendLaunch" targetRef="Task_Launch" />
    <bpmn2:messageFlow id="Flow_Msg_Withdraw" sourceRef="Task_SendWithdraw" targetRef="Task_Withdraw" />
    <bpmn2:messageFlow id="Flow_Msg_Payout" sourceRef="Task_Transfer" targetRef="Participant_Creator" />
  </bpmn2:collaboration>
  <bpmn2:process id="Process_Creator">
    <bpmn2:startEvent id="Event_CreatorStart">
      <bpmn2:outgoing>Flow_C1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:sendTask id="Task_SendLaunch" bpmnbc:bc="true" bpmnbc:bctype="SendTask" bpmnbc:bcid="network-1" name="Launch Campaign">
      <bpmn2:incoming>Flow_C1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_C2</bpmn2:outgoing>
    </bpmn2:sendTask>
    <bpmn2:intermediateCatchEvent id="Event_CatchGoal" bpmnbc:bc="true" bpmnbc:bctype="IntermediateCatchEvent" bpmnbc:bcevent="catchEvent" bpmnbc:bceventname="GoalReached" name="Goal Reached">
      <bpmn2:incoming>Flow_C2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_C3</bpmn2:outgoing>
    </bpmn2:intermediateCatchEvent>
    <bpmn2:sendTask id="Task_SendWithdraw" bpmnbc:bc="true" bpmnbc:bctype="SendTask" bpmnbc:bcid="network-1" name="Withdraw Funds">
      <bpmn2:incoming>Flow_C3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_C4</bpmn2:outgoing>
    </bpmn2:sendTask>
    <bpmn2:endEvent id="Event_CreatorEnd">
      <bpmn2:incoming>Flow_C4</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_C1" sourceRef="Event_CreatorStart" targetRef="Task_SendLaunch" />
    <bpmn2:sequenceFlow id="Flow_C2" sourceRef="Task_SendLaunch" targetRef="Event_CatchGoal" />
    <bpmn2:sequenceFlow id="Flow_C3" sourceRef="Event_CatchGoal" targetRef="Task_SendWithdraw" />
    <bpmn2:sequenceFlow id="Flow_C4" sourceRef="Task_SendWithdraw" targetRef="Event_CreatorEnd" />
  </bpmn2:process>
  <bpmn2:process id="Process_Campaign">
    <bpmn2:startEvent id="Event_CampaignStart">
      <bpmn2:outgoing>Flow_P1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:receiveTask id="Task_Launch" bpmnbc:bc="true" bpmnbc:bctype="ReceiveTask" bpmnbc:bcsender="Creator" bpmnbc:bcid="network-1" name="Launch Campaign">
      <bpmn2:incoming>Flow_P1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P2</bpmn2:outgoing>
      <bpmn2:dataOutputAssociation id="Assoc_LaunchWrite">
        <bpmn2:extensionElements>
          <bpmnbc:dataStoreVarSelections>
            <bpmnbc:dataStoreVarSelection varname="goal_WEI" external="true" />
          </bpmnbc:dataStoreVarSelections>
        </bpmn2:extensionElements>
        <bpmn2:targetRef>DS_Campaign_1</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
    </bpmn2:receiveTask>
    <bpmn2:intermediateThrowEvent id="Event_Launched" bpmnbc:bc="true" bpmnbc:bctype="IntermediateThrowEvent" bpmnbc:bcevent="throwEvent" bpmnbc:bcid="network-1" name="Campaign Launched">
      <bpmn2:incoming>Flow_P2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P3</bpmn2:outgoing>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:receiveTask id="Task_Pledge" bpmnbc:bc="true" bpmnbc:bctype="ReceiveTask" bpmnbc:bcid="network-1" bpmnbc:bcpayable="true" bpmnbc:bcopen="true" bpmnbc:bcloopcondition="raised &#60; goal_WEI" name="Pledge">
      <bpmn2:incoming>Flow_P3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P4</bpmn2:outgoing>
      <bpmn2:property id="Prop_PledgeIn" name="__targetRef_placeholder" />
      <bpmn2:dataInputAssociation id="Assoc_PledgeRead">
        <bpmn2:extensionElements>
          <bpmnbc:dataStoreVarSelections>
            <bpmnbc:dataStoreVarSelection varname="raised" />
            <bpmnbc:dataStoreVarSelection varname="goal_WEI" />
          </bpmnbc:dataStoreVarSelections>
        </bpmn2:extensionElements>
        <bpmn2:sourceRef>DS_Campaign_4</bpmn2:sourceRef>
        <bpmn2:targetRef>Prop_PledgeIn</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
      <bpmn2:dataOutputAssociation id="Assoc_PledgeWrite">
        <bpmn2:extensionElements>
          <bpmnbc:dataStoreVarSelections>
            <bpmnbc:dataStoreVarSelection varname="raised" value="raised + msg.value" external="false" />
          </bpmnbc:dataStoreVarSelections>
        </bpmn2:extensionElements>
        <bpmn2:targetRef>DS_Campaign_2</bpmn2:targetRef>
      </bpmn2:dataOutputAssociation>
      <bpmn2:standardLoopCharacteristics />
    </bpmn2:receiveTask>
    <bpmn2:intermediateThrowEvent id="Event_GoalReached" bpmnbc:bc="true" bpmnbc:bctype="IntermediateThrowEvent" bpmnbc:bcevent="throwEvent" bpmnbc:bcid="network-1" name="Goal Reached">
      <bpmn2:incoming>Flow_P4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P5</bpmn2:outgoing>
    </bpmn2:intermediateThrowEvent>
    <bpmn2:receiveTask id="Task_Withdraw" bpmnbc:bc="true" bpmnbc:bctype="ReceiveTask" bpmnbc:bcsender="Creator" bpmnbc:bcid="network-1" name="Withdraw Funds">
      <bpmn2:incoming>Flow_P5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P6</bpmn2:outgoing>
    </bpmn2:receiveTask>
    <bpmn2:scriptTask id="Task_Transfer" bpmnbc:bc="true" bpmnbc:bctype="ScriptTask" bpmnbc:bcid="network-1" bpmnbc:solidityscript="(bool success, ) = payable(addressOf[&#34;Creator&#34;]).call{value: raised}(&#34;&#34;);&#10;require(success, &#34;transfer failed&#34;);" name="Transfer Funds">
      <bpmn2:incoming>Flow_P6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_P7</bpmn2:outgoing>
      <bpmn2:property id="Prop_TransferIn" name="__targetRef_placeholder" />
      <bpmn2:dataInputAssociation id="Assoc_TransferRead">
        <bpmn2:extensionElements>
          <bpmnbc:dataStoreVarSelections>
            <bpmnbc:dataStoreVarSelection varname="raised" />
          </bpmnbc:dataStoreVarSelections>
        </bpmn2:extensionElements>
        <bpmn2:sourceRef>DS_Campaign_3</bpmn2:sourceRef>
        <bpmn2:targetRef>Prop_TransferIn</bpmn2:targetRef>
      </bpmn2:dataInputAssociation>
    </bpmn2:scriptTask>
    <bpmn2:endEvent id="Event_CampaignEnd">
      <bpmn2:incoming>Flow_P7</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_P1" sourceRef="Event_CampaignStart" targetRef="Task_Launch" />
    <bpmn2:sequenceFlow id="Flow_P2" sourceRef="Task_Launch" targetRef="Event_Launched" />
    <bpmn2:sequenceFlow id="Flow_P3" sourceRef="Event_Launched" targetRef="Task_Pledge" />
    <bpmn2:sequenceFlow id="Flow_P4" sourceRef="Task_Pledge" targetRef="Event_GoalReached" />
    <bpmn2:sequenceFlow id="Flow_P5" sourceRef="Event_GoalReached" targetRef="Task_Withdraw" />
    <bpmn2:sequenceFlow id="Flow_P6" sourceRef="Task_Withdraw" targetRef="Task_Transfer" />
    <bpmn2:sequenceFlow id="Flow_P7" sourceRef="Task_Transfer" targetRef="Event_CampaignEnd" />
    <bpmn2:dataStoreReference id="DS_Campaign_1" name="Campaign">
      <bpmn2:extensionElements>
        <bpmnbc:dataStoreVariables>
          <bpmnbc:dataStoreVariable name="goal_WEI" type="uint" />
          <bpmnbc:dataStoreVariable name="raised" type="uint" />
        </bpmnbc:dataStoreVariables>
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="DS_Campaign_2" name="Campaign">
      <bpmn2:extensionElements>
        <bpmnbc:dataStoreVariables>
          <bpmnbc:dataStoreVariable name="goal_WEI" type="uint" />
          <bpmnbc:dataStoreVariable name="raised" type="uint" />
        </bpmnbc:dataStoreVariables>
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="DS_Campaign_3" name="Campaign">
      <bpmn2:extensionElements>
        <bpmnbc:dataStoreVariables>
          <bpmnbc:dataStoreVariable name="goal_WEI" type="uint" />
          <bpmnbc:dataStoreVariable name="raised" type="uint" />
        </bpmnbc:dataStoreVariables>
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:dataStoreReference id="DS_Campaign_4" name="Campaign">
      <bpmn2:extensionElements>
        <bpmnbc:dataStoreVariables>
          <bpmnbc:dataStoreVariable name="goal_WEI" type="uint" />
          <bpmnbc:dataStoreVariable name="raised" type="uint" />
        </bpmnbc:dataStoreVariables>
      </bpmn2:extensionElements>
    </bpmn2:dataStoreReference>
    <bpmn2:textAnnotation id="Note_Pledge">
      <bpmn2:text>Open task: anyone can pledge, as often as they like, until the goal is reached</bpmn2:text>
    </bpmn2:textAnnotation>
    <bpmn2:association id="Assoc_Note_Pledge" associationDirection="None" sourceRef="Task_Pledge" targetRef="Note_Pledge" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="Diagram_Crowdfunding">
    <bpmndi:BPMNPlane id="Plane_Crowdfunding" bpmnElement="Collaboration_43247181">
